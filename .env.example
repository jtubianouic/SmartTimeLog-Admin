# Client-safe configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never expose these through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=
REGISTRATION_TOKEN_SECRET=
RESEND_API_KEY=
# Sender must use a domain verified in Resend.
REGISTRATION_NOTIFICATION_FROM_EMAIL=
# Optional on Vercel: it uses VERCEL_PROJECT_PRODUCTION_URL automatically.
# Set this for local testing or to override the public approval-link origin.
APP_BASE_URL=
AI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

OMNI_API_KEY=your_omni_api_key_here
OMNI_ROUTE_URL=your_omni_route_url_here
OMNI_MODEL=auto
